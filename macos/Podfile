platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The signing team is read from this machine's signing environment, never
# written down: the development certificate flutter is set to use
# (`flutter config --select-ios-signing-settings`), or the only one in the
# keychain. The team is that certificate's organizational unit.
def write_signing_team
  require 'json'
  cert = nil
  ['~/.config/flutter/settings', '~/.flutter_settings'].each do |f|
    path = File.expand_path(f)
    next unless File.exist?(path)
    cert ||= (JSON.parse(File.read(path))['ios-signing-cert'] rescue nil)
  end
  if cert.nil?
    ids = `security find-identity -v -p codesigning`.scan(/"(Apple Development: [^"]+)"/).flatten.uniq
    cert = ids.first if ids.length == 1
  end
  team = nil
  if cert
    pem = `security find-certificate -c "#{cert}" -p 2>/dev/null`
    subject = IO.popen(%w[openssl x509 -noout -subject -nameopt multiline], 'r+') do |io|
      io.write(pem)
      io.close_write
      io.read
    end
    team = subject[/organizationalUnitName\s*=\s*(\S+)/, 1]
  end
  File.write(File.join(__dir__, 'Flutter', 'Team.xcconfig'),
             "// Generated by the Podfile from this machine's signing certificate.\n" +
             (team ? "DEVELOPMENT_TEAM = #{team}\n" : ''))
end

post_install do |installer|
  write_signing_team
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      # Xcode 27 refuses deployment targets below 12.0, and several pods still
      # declare 10.14-10.15 in their podspec. Raise every one to the project floor.
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    end
  end
end
